VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAPBOX_TOKEN=
# TURN relay for mobile Symmetric NAT (required for reliable 4G/5G WebRTC).
# Aliases: VITE_TURN_URLS / VITE_TURN_USERNAME / VITE_TURN_CREDENTIAL also work.
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_CRED=
# Cloudflare R2 (S3-compatible media storage)
VITE_R2_ACCOUNT_ID=
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET=
# Public base URL (custom domain or r2.dev), no trailing slash
VITE_R2_PUBLIC_URL=
# Ссылки на тестовые сборки (APK / TestFlight / внутренний CDN).
# Если пусто — кнопки на стартовом экране открывают веб-клиент.
VITE_ANDROID_CLIENT_URL=
VITE_IOS_CLIENT_URL=
